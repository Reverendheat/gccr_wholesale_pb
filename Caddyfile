# Replace with your actual domain. Caddy auto-provisions and renews TLS via Let's Encrypt.
wholesale.groundcontrolroasters.com {
    # Restrict the PocketBase admin panel to your IP(s) only.
    @admin path /_/*
    handle @admin {
        @allowed remote_ip 0.0.0.0/0  # Replace with your actual IP(s), e.g. 1.2.3.4/32
        handle @allowed {
            reverse_proxy app:8090
        }
        respond 403
    }

    reverse_proxy app:8090
}
