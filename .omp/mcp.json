{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "square_prod": {
      "type": "sse",
      "url": "https://mcp.squareup.com/sse"
    },
    "square_sandbox": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "square-mcp-server@0.1.2",
        "start"
      ],
      "env": {
        "ACCESS_TOKEN": "${SQUARE_ACCESS_TOKEN}",
        "SANDBOX": "true"
      }
    }
  }
}