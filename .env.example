# Square API
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_WHOLESALE_CATEGORY_ID=your_wholesale_category_id_here
SQUARE_WHOLESALE_GROCERY_GROUP_ID=your_wholesale_grocery_group_id_here
SQUARE_WHOLESALE_CAFE_RESTAURANT_GROUP_ID=your_wholesale_cafe_restaurant_group_id_here
SQUARE_WHOLESALE_GROCERY_ATTRIBUTE_ID=your_wholesale_grocery_attribute_id_here
SQUARE_WHOLESALE_CAFE_RESTAURANT_ATTRIBUTE_ID=your_wholesale_cafe_restaurant_attribute_id_here
SQUARE_WHOLESALE_CUSTOMER_ALLOWLIST_ATTRIBUTE_ID=your_wholesale_customer_allowlist_attribute_id_here
SQUARE_SANDBOX=true

# Local delivery (OpenRouteService / HeiGIT)
ORS_API_KEY=your_openrouteservice_api_key_here
DELIVERY_MAX_MILES=30
DELIVERY_FREE_MINIMUM_CENTS=10000
DELIVERY_RATE_CENTS_PER_MILE=50

# Square Webhooks
# Register this URL in your Square Developer Dashboard under Webhooks.
# Subscribe to invoice.payment_made, invoice.canceled, and invoice.refunded.
SQUARE_WEBHOOK_URL=https://your-domain.com/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key_here

# PocketBase (optional — defaults to pb_data in the current directory)
# PB_DATA_DIR=./pb_data

# PocketBase app/email settings
PB_APP_NAME=GCCR Wholesale
PB_APP_URL=https://your-domain.com
PB_SENDER_NAME=GCCR Wholesale
PB_SENDER_ADDRESS=no-reply@your-domain.com

# PocketBase SMTP settings
PB_SMTP_ENABLED=true
PB_SMTP_HOST=smtp.example.com
PB_SMTP_PORT=587
PB_SMTP_USERNAME=your_smtp_username
PB_SMTP_PASSWORD=your_smtp_password
PB_SMTP_AUTH_METHOD=PLAIN
PB_SMTP_TLS=false
# PB_SMTP_LOCAL_NAME=your-domain.com
